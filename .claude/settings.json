{
  "permissions": {
    "allow": [
      "Bash(bundle exec rspec *)",
      "Bash(bundle exec rake *)",
      "Bash(rubocop *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-generated-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rubocop-autocorrect.sh"
          }
        ]
      }
    ]
  }
}
